{
  "name": "cdm-plenum",
  "version": "0.0.0",
  "private": true,
  "description": "Guides a group from the scope of a clinical concept to an agreed set of data elements, with brainstorming and Delphi-style rating rounds before CKM review",
  "license": "Apache-2.0",
  "author": "Sophie de Klerk",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "pnpm i18n && tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm i18n && vitest run",
    "test:watch": "pnpm i18n && vitest",
    "test:coverage": "pnpm i18n && vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:ckm": "pnpm i18n && CKM_CONTRACT=1 vitest run src/server/ckm/contract.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "i18n": "paraglide-js compile --project ./project.inlang --silent",
    "db:migrate": "node src/server/db/migrate.ts",
    "db:generate-types": "kysely-codegen --dialect postgres --out-file src/server/db/schema.gen.ts",
    "db:seed-demo": "pnpm i18n && node --import ./scripts/node/alias-hooks.mjs src/server/db/seed-demo.ts",
    "admin:grant": "node src/server/admin/grant.ts grant",
    "admin:revoke": "node src/server/admin/grant.ts revoke"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.7.25",
    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "fast-xml-parser": "5.12.1",
    "kysely": "0.29.9",
    "lucide-react": "1.75.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "31.0.0",
    "kysely-codegen": "0.20.0",
    "nitro": "3.0.261103-rc",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
