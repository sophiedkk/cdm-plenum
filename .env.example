#
# The settings of the production stack (compose.yaml). Copy this file to
# .env, fill in the values and keep .env readable by its owner only
# (chmod 600 .env). Never commit .env. docs/deployment.md explains each one.

# The password of the PostgreSQL role. compose.yaml builds DATABASE_URL from
# it, so use characters that need no escaping in a URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# DATABASE_URL is set by compose.yaml from POSTGRES_PASSWORD.

# At least 32 characters, for signing sessions: openssl rand -base64 48
BETTER_AUTH_SECRET=

# The public address of the app, as the reverse proxy serves it.
BETTER_AUTH_URL=https://cdm-plenum.example.org

# The institution's SMTP server, with the sender address. Without SMTP_URL the
# app sends no e-mail: facilitators copy invitation links, and nobody gets a
# sign-in link.
SMTP_URL=
MAIL_FROM=

# The CKM REST API. Empty is the international CKM.
CKM_BASE_URL=

# The loopback port the reverse proxy forwards to (default 3000).
CDM_PLENUM_PORT=3000
